# Claude AI API Key
# Ottieni la tua chiave da: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Configurazione Account Email
# Formato JSON con array di account
EMAIL_ACCOUNTS='[
    {
        "name": "Gmail Personale",
        "type": "gmail",
        "email": "tuo@gmail.com",
        "credentials_file": "credentials/gmail_credentials.json"
    },
    {
        "name": "Email Lavoro IMAP",
        "type": "imap",
        "host": "imap.gmail.com",
        "port": 993,
        "email": "lavoro@example.com",
        "password": "your-app-password-here",
        "use_ssl": true
    }
]'

# Configurazione AI
AI_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=4096
TEMPERATURE=0.3

# Configurazione Analisi
# Numero massimo di email da analizzare per sessione
MAX_EMAILS_PER_RUN=50

# Giorni di storico da analizzare
DAYS_TO_ANALYZE=7

# Cache
USE_CACHE=true
CACHE_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/email_optimizer.log
